# Keep new reproducibility artifacts byte-stable on Windows and Unix.
/scripts/** text eol=lf
/tests/** text eol=lf
/analysis/** text eol=lf
# Preserve downloaded evidence, including original trailing whitespace.
/analysis/provenance/sources/** -text -whitespace
/patoshi_p2pkh_addresses.csv text eol=lf
/requirements-analysis.txt text eol=lf
/.gitignore text eol=lf
/.gitattributes text eol=lf
/analysis/phase2_bigquery/*.gz -text
/analysis/phase2_bigquery/schema/* -text
# Preserve downloaded client sources byte-for-byte (checksummed in the Phase 9 manifest), and binary results.
/analysis/phase9_nonce_clock/sources/** -text -whitespace
/analysis/phase9_nonce_clock/results/*.npy -text
