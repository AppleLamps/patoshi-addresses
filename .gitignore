__pycache__/
*.py[cod]
# Downloaded prose/HTML and redundant source copies stay in the local cache.
/analysis/provenance/sources/*.html
/analysis/provenance/sources/*_doc*.md
/analysis/provenance/sources/*.patch
/analysis/provenance/sources/bensig_csv.csv
/analysis/provenance/sources/bensig_extractor.py
/analysis/provenance/sources/lopp_streaks.php
/analysis/provenance/sources/tehran_patoshiBlocks.js

# Phase 2 immutable response cache and background-run state; manifests are committed.
/analysis/phase2/cache/
/analysis/phase2/*.log
/analysis/phase2/*.lock
/analysis/phase2/progress.json
/analysis/phase2/job.json

# BigQuery query outputs are committed as CSV. Full REST envelopes stay local.
/analysis/phase2_bigquery/cache/*
!/analysis/phase2_bigquery/cache/schema_*.json
!/analysis/phase2_bigquery/cache/tables.json
/analysis/phase2_bigquery/*.log
/.firecrawl/
/analysis/phase3/cache/
/analysis/phase3/*.log
/analysis/phase5/cache/
/analysis/phase5/*.log
/analysis/phase8/cache/
/analysis/phase9_nonce_clock/cache/
